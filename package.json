{
  "name": "writo-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix proj-experiment-writo-web run dev",
    "dev:web": "npm --prefix proj-experiment-writo-web run dev",
    "dev:extension": "npm --prefix proj-experiment-writo-extension run dev",
    "build": "npm --prefix proj-experiment-writo-web run build",
    "build:web": "npm --prefix proj-experiment-writo-web run build",
    "build:extension": "npm --prefix proj-experiment-writo-extension run build",
    "build:all": "npm --prefix proj-experiment-writo-web run build && npm --prefix proj-experiment-writo-extension run build",
    "preview": "npm --prefix proj-experiment-writo-web run preview"
  }
}
